{
  "name": "herugrim",
  "version": "1.0.0",
  "description": "Discord OIDC provider for Cloudflare Access, running on Cloudflare Workers",
  "main": "worker.js",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "check": "wrangler deploy --dry-run --outdir dist",
    "generate-key": "node scripts/generate-key.mjs",
    "prepare": "husky",
    "release": "commit-and-tag-version",
    "release:alpha": "commit-and-tag-version --prerelease alpha",
    "release:patch": "commit-and-tag-version --release-as patch",
    "release:minor": "commit-and-tag-version --release-as minor",
    "release:major": "commit-and-tag-version --release-as major"
  },
  "author": "quietarcade (https://github.com/quietarcade)",
  "license": "MIT",
  "dependencies": {
    "hono": "^4.13.13",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "commit-and-tag-version": "^13.3.0",
    "husky": "^9.1.7",
    "wrangler": "^4.151.0"
  }
}
